{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Claude Code — light_worker (DeepSeek Flash)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\start-deepseek-claude.ps1",
        "-Worker",
        "light"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
